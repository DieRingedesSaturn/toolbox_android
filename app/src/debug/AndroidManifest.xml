<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The Developer-options mock-location picker lists apps that declare this.
         Selecting Toolbox there grants AppOps; declaring it does not enable mocking. -->
    <!-- Already confined to src/debug; suppress the merged-manifest detector's false positive. -->
    <uses-permission android:name="android.permission.ACCESS_MOCK_LOCATION"
        tools:ignore="MockLocation" />
</manifest>
